# Copy this file to .env and fill in your values

# Google Maps API (required for route monitoring in ML API / risk fusion)
GOOGLE_API_KEY=your_google_maps_api_key_here

# ML API (ml_api on Cloud Run or local)
# Leave ML_API_KEY empty locally to skip X-API-Key checks.
ML_API_KEY=
# OpenWeatherMap current weather → weather_encoded feature (optional)
OPENWEATHER_API_KEY=

# Model Configuration
MODEL_DIR=models
FUSION_GB_WEIGHT=0.7
FUSION_IF_WEIGHT=0.3

# Risk Thresholds
SAFE_THRESHOLD=0.3
MEDIUM_THRESHOLD=0.7

# Route Anomaly Detection
ROUTE_BUFFER_DISTANCE=100
ROUTE_DEVIATION_CRITICAL=500
ROUTE_REROUTE_CHECK_INTERVAL=30

# Alert Configuration
CONSECUTIVE_HIGH_RISK_THRESHOLD=3
ALERT_COOLDOWN_PERIOD=30

# Feature Extraction
FEATURE_WINDOW_SIZE=10

# Logging
LOG_LEVEL=INFO

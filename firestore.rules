rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if the user owns this resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: check if user is an admin (has admin custom claim)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Never delete user docs from client
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false; // Trips are never deleted from client

      // Sensor data subcollection
      match /sensor_data/{eventId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid
          || isAdmin();
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }

      // Current state subcollection (written by cloud functions)
      match /current_state/{stateId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only cloud functions write this
      }

      // Alerts subcollection
      match /alerts/{alertId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    // Emergency alerts (top-level)
    match /emergency_alerts/{alertId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // Escalation timers (cloud functions only)
    match /escalation_timers/{timerId} {
      allow read: if isAdmin();
      allow write: if false; // Only cloud functions
    }

    // Admin notifications
    match /admin_notifications/{notifId} {
      allow read: if isAdmin();
      allow create: if false; // Only cloud functions
      allow update: if isAdmin(); // Admins can mark as read
      allow delete: if false;
    }

    // Devices collection
    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Trip feedback (new — for ML validation)
    match /trip_feedback/{feedbackId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}

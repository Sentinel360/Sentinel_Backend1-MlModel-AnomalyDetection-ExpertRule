rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Users — each user can only read/write their own document
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Emergency contacts subcollection — owner only
      match /emergency_contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ---------------------------------------------------------------
    // Devices — owner only
    // ---------------------------------------------------------------
    match /devices/{deviceId} {
      allow read, write: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // ---------------------------------------------------------------
    // Trips — owner read/write; admin can read all
    // ---------------------------------------------------------------
    match /trips/{tripId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.admin == true);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Sensor data sub-collection — owner only
      match /sensor_data/{eventId} {
        allow read, write: if request.auth != null;
      }

      // Current state — written by Cloud Functions (admin SDK bypasses rules)
      // AND by the mobile app on trip start (initial safe state).
      // Readable by authenticated users.
      match /current_state/{docId} {
        allow read, write: if request.auth != null;
      }

      // Alerts sub-collection — Cloud Functions write most alerts,
      // but the mobile app writes SOS_MANUAL alerts via TripManager.triggerSOS()
      match /alerts/{alertId} {
        allow read, write: if request.auth != null;
      }
    }

    // ---------------------------------------------------------------
    // Emergency alerts — user can create, admin can read all
    // ---------------------------------------------------------------
    match /emergency_alerts/{alertId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.admin == true);
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Trip feedback — write-once per user per trip
    // ---------------------------------------------------------------
    match /trip_feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.admin == true);
    }

    // ---------------------------------------------------------------
    // Escalation timers — Cloud Functions only (admin SDK bypasses rules)
    // Admin dashboard can read
    // ---------------------------------------------------------------
    match /escalation_timers/{timerId} {
      allow read: if request.auth != null
        && request.auth.token.admin == true;
    }

    // ---------------------------------------------------------------
    // Admin notifications — admin read only
    // ---------------------------------------------------------------
    match /admin_notifications/{notifId} {
      allow read: if request.auth != null
        && request.auth.token.admin == true;
    }
  }
}
